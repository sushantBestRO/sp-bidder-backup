<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.webServer>
		<rewrite>
			<rules>
				<rule name="Bids Reverse Proxy" stopProcessing="true">
					<match url="(.*)" />
					<serverVariables>
						<set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
					</serverVariables>
					<action type="Rewrite"
							url="http://127.0.0.1:4103/{R:1}"
							appendQueryString="true" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>